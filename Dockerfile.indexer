FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip

# PyTorch CUDA wheels are self-contained (bundle their own CUDA libs),
# so no CUDA base image is needed.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu121

RUN pip install --no-cache-dir --timeout 1000 --prefer-binary \
    transformers \
    faiss-cpu \
    tqdm \
    pyyaml \
    huggingface_hub \
    pandas \
    numpy \
    requests

COPY src/retriever.py src/retriever.py
COPY src/build_index_entrypoint.py src/build_index_entrypoint.py

CMD ["python", "src/build_index_entrypoint.py", "--config", "/app/config/config.yaml"]
