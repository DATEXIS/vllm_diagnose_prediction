FROM pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip

# Install CUDA-enabled torch via pip so it takes precedence over the
# conda-installed one; without this, `pip install transformers` installs
# a CPU-only torch on top, making AutoModel fail with "PyTorch not found".
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu121

RUN pip install --no-cache-dir --timeout 1000 \
    transformers \
    faiss-cpu \
    tqdm \
    pyyaml \
    huggingface_hub \
    pandas \
    numpy

COPY src/retriever.py src/retriever.py
COPY src/build_index_entrypoint.py src/build_index_entrypoint.py

CMD ["python", "src/build_index_entrypoint.py", "--config", "/app/config/config.yaml"]
